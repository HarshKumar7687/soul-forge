# ===== Backend (copy to backend/.env) =====
# REQUIRED
MONGODB_URI=mongodb://127.0.0.1:27017/soulforge
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

# OPTIONAL (defaults shown)
# Uploaded portraits are files, stored in backend/uploads by default. If you replace or move the project
# folder, images vanish while the database still points at them. Set this to a permanent folder outside the project.
# UPLOAD_DIR=/home/you/soulforge-uploads
PORT=4000
NODE_ENV=development
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# REQUIRED for chat (Phase 3). Without them the app runs and chat shows a setup message.
LLM_PROVIDER=openrouter            # openrouter | huggingface | ollama
# Ollama: LLM_PROVIDER=ollama, LLM_MODEL=<name from `ollama list`>, no API key needed.
# It talks to http://localhost:11434/v1 unless you set LLM_BASE_URL.
LLM_API_KEY=
# Examples: openrouter -> "meta-llama/llama-3.3-70b-instruct"; huggingface -> "meta-llama/Llama-3.3-70B-Instruct"
LLM_MODEL=

# OPTIONAL: allow private 18+ characters and stories (adults only, never public). Default off.
# Your model must also be willing to write mature themes; the app cannot change a model's own limits.
ALLOW_MATURE_CONTENT=false

# OPTIONAL: semantic memory search. Needs a model your provider serves at /embeddings.
# Without it, memories are matched by keywords.
# EMBEDDING_MODEL=

# OPTIONAL speed tuning. Smaller prompts and shorter replies make local models (Ollama) much faster.
# CHAT_REPLY_LENGTH=short         # short | medium | long: how long the AI's replies tend to be
# CHAT_HISTORY_MESSAGES=8          # how many recent messages the AI sees each time
# CHAT_HISTORY_CHARS=4000          # hard cap on their combined size
# MEMORY_RETRIEVE_LIMIT=4          # how many relevant memories are added to each prompt (0 = none)
# MEMORY_EVERY_MESSAGES=6          # look for new important memories after this many of your messages
# CHAT_SUMMARY=false               # set true to also keep a rolling summary of older messages (extra AI calls)

# OPTIONAL chat tuning (defaults shown)
# LLM_BASE_URL=                    # override the provider's API base URL
# LLM_STREAMING=true               # set false for models that do not stream
# LLM_TIMEOUT_MS=60000
# LLM_MAX_TOKENS=400
# LLM_TEMPERATURE=0.8

# OPTIONAL: AI portrait generation. Uploading an image always works without it.
IMAGE_PROVIDER=huggingface          # huggingface | openai (any OpenAI-style /images/generations API)
IMAGE_API_KEY=
IMAGE_MODEL=                        # e.g. black-forest-labs/FLUX.1-schnell on huggingface
# IMAGE_BASE_URL=
# IMAGE_TIMEOUT_MS=90000
